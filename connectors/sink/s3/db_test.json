{
  "name": "s3-debezium-sink-connector",
  "config": {
    "connector.class": "io.confluent.connect.s3.S3SinkConnector",
    "topics.dir":"/dev/parquet/cdc/db_test",
    "topics": "db_test.public.students",
    "s3.region": "us-east-1",
    "s3.bucket.name": "YOUR-TARGET-S3-BUCKET",
    "flush.size": "1000",
    "partitioner.class": "io.confluent.connect.s3.storage.partioner.TimeBasedPartitioner",
    "locale":"en",
    "timezone":"UTC",
    "path.format": "'year'=YYYY/'month'=MM/'day'=dd/'hour'=HH",
    "partition.duration.ms":"-1",
    "rotate.schedule.interval.ms":"1800000",
    "s3.part.size":10214400,
    "timestamp.extractor": "Wallclock",
    "storage.class": "io.confluent.connect.s3.storage.S3Storage",
    "format.class": "io.confluent.connect.s3.format.parquet.ParquetFormat",
    "headers.format.class":"io.confluent.connect.s3.format.parquet.ParquetFormat",
    "keys.format.class":"io.confluent.connect.s3.format.parquet.ParquetFormat",
    "parquet.codec": "snappy",
    "schema.generator.class":"io.confluent.connect.storage.hive.schema.DefaultSchemaGenerator",
    "behavior.on.null.values":"ignore",
    "aws.access.key_id": "YOUR-AWS-ACCESS-KEY",
    "aws.secret.access_key": "YOUR-AWS-SECRET-KEY"
  }
}
